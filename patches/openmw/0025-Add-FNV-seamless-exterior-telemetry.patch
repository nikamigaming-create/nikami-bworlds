     };
+    static unsigned int seamlessTelemetryLastFrame = 0;
+    static bool seamlessTelemetryHasFrameSample = false;
+    if (Debug::FNVSeamlessTelemetry::enabled())
+    {
+        const unsigned int sampleInterval = Debug::FNVSeamlessTelemetry::frameSampleInterval();
+        const bool sampleDue = !seamlessTelemetryHasFrameSample || sampleInterval == 0
+            || frameNumber >= seamlessTelemetryLastFrame + sampleInterval;
+        if (sampleDue)
+        {
+            Debug::FNVSeamlessTelemetry::Event("frame-sample")
+                .integer("frame", frameNumber)
+                .number("frameTimeMs", static_cast<double>(frametime) * 1000.0)
+                .string("memoryStatus", "not-collected")
+                .emit();
+            seamlessTelemetryLastFrame = frameNumber;
+            seamlessTelemetryHasFrameSample = true;
+        }
+    }
